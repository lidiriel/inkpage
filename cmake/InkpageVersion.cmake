# Version of inkpage, taken from the git tag of the release "vX.Y.Z":
#
#   at the tag            X.Y.Z                       (a release)
#   N commits later       X.Y.Z+gitN.gHASH            (a development snapshot)
#   uncommitted changes   ...+dirty / ...dirty        (for example 0.3.0+dirty)
#
# A snapshot is sorted by Debian after the release X.Y.Z and before the next one.
# Without a git checkout or without a tag (for example an exported source tree),
# INKPAGE_BASE_VERSION is used.
#
# Included by CMakeLists.txt: inkpage_compute_version() sets INKPAGE_VERSION
# (X.Y.Z, the version of the CMake project), INKPAGE_FULL_VERSION (the version of
# the application and of the package), INKPAGE_IS_RELEASE and INKPAGE_GIT_COMMIT.
#
# Run as a script (cmake -P) at every build, it writes the header with the version
# of the application, so a new commit does not need a new configuration:
#   -DINKPAGE_SOURCE_DIR=... -DINKPAGE_BASE_VERSION=... -DINKPAGE_VERSION_HEADER=...

function(inkpage_compute_version sourceDir baseVersion)
    set(version ${baseVersion})
    set(fullVersion ${baseVersion})
    set(isRelease OFF)
    set(commit "")

    find_package(Git QUIET)
    if(GIT_FOUND AND EXISTS "${sourceDir}/.git")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${sourceDir}" describe --tags --long --dirty --match "v[0-9]*.[0-9]*.[0-9]*"
                        OUTPUT_VARIABLE describe RESULT_VARIABLE result ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${sourceDir}" rev-parse --short=7 HEAD
                        OUTPUT_VARIABLE commit ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)

        if(result EQUAL 0 AND describe MATCHES "^v([0-9]+\\.[0-9]+\\.[0-9]+)-([0-9]+)-g([0-9a-f]+)(-dirty)?$")
            set(version ${CMAKE_MATCH_1})
            set(count ${CMAKE_MATCH_2})
            set(hash ${CMAKE_MATCH_3})
            set(dirty ${CMAKE_MATCH_4})
            set(fullVersion ${version})
            if(count GREATER 0)
                string(APPEND fullVersion "+git${count}.g${hash}")
            endif()
            if(dirty)
                if(count GREATER 0)
                    string(APPEND fullVersion ".dirty")
                else()
                    string(APPEND fullVersion "+dirty")
                endif()
            endif()
            if(count EQUAL 0 AND NOT dirty)
                set(isRelease ON)
            endif()
        elseif(commit)
            # No release tag yet: the commits are counted from the beginning
            execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${sourceDir}" rev-list --count HEAD
                            OUTPUT_VARIABLE count ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
            execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${sourceDir}" describe --always --dirty
                            OUTPUT_VARIABLE describe ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
            set(fullVersion "${baseVersion}+git${count}.g${commit}")
            if(describe MATCHES "-dirty$")
                string(APPEND fullVersion ".dirty")
            endif()
        endif()
    endif()

    set(INKPAGE_VERSION ${version} PARENT_SCOPE)
    set(INKPAGE_FULL_VERSION ${fullVersion} PARENT_SCOPE)
    set(INKPAGE_IS_RELEASE ${isRelease} PARENT_SCOPE)
    set(INKPAGE_GIT_COMMIT "${commit}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
    inkpage_compute_version("${INKPAGE_SOURCE_DIR}" "${INKPAGE_BASE_VERSION}")
    set(content "// Generated by cmake/InkpageVersion.cmake, do not edit\n#define INKPAGE_VERSION \"${INKPAGE_FULL_VERSION}\"\n")

    # The header is written only when the version changes, so nothing is rebuilt otherwise
    set(oldContent "")
    if(EXISTS "${INKPAGE_VERSION_HEADER}")
        file(READ "${INKPAGE_VERSION_HEADER}" oldContent)
    endif()
    if(NOT oldContent STREQUAL content)
        file(WRITE "${INKPAGE_VERSION_HEADER}" "${content}")
    endif()
endif()
